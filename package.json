{
  "name": "purecut",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "context:report": "node scripts/context-report.mjs",
    "context:check": "node scripts/context-report.mjs --check",
    "test:regression": "node tests/e2e/regression.mjs",
    "test:regression:fast": "node tests/e2e/regression.mjs --no-model",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@imgly/background-removal": "^1.5.7",
    "coi-serviceworker": "^0.1.7",
    "lucide-vue-next": "^0.475.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
