{
  "name": "purecut",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open --port 5176",
    "build": "vite build",
    "preview": "vite preview",
    "rmbg2": "node rmbg2/rmbg2.mjs",
    "rmbg2:help": "node rmbg2/rmbg2.mjs --help",
    "rmbg2:list": "node rmbg2/rmbg2.mjs --list",
    "rmbg2:lab": "vite --port 5177 --open /rmbg2",
    "rmbg2:preload": "node rmbg2/rmbg2.mjs --preload",
    "rmbg2:preload:all": "node rmbg2/rmbg2.mjs --preload --all",
    "rmbg2:bench": "node rmbg2/rmbg2-bench.mjs",
    "rmbg2:apitest": "node rmbg2/rmbg2-apitest.mjs",
    "rmbg2:tokentest": "node rmbg2/rmbg2-tokentest.mjs",
    "rmbg2:reruntest": "node rmbg2/rmbg2-reruntest.mjs",
    "rmbg2:releasetest": "node rmbg2/rmbg2-releasetest.mjs",
    "typecheck": "vue-tsc --noEmit",
    "context:report": "node scripts/context-report.mjs",
    "context:check": "node scripts/context-report.mjs --check",
    "test:regression": "node tests/e2e/regression.mjs",
    "test:regression:fast": "node tests/e2e/regression.mjs --no-model",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@imgly/background-removal": "^1.5.7",
    "coi-serviceworker": "^0.1.7",
    "lucide-vue-next": "^0.475.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "onnxruntime-node": "^1.30.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
